          {
            "group": "Brands API",
            "pages": [
              "api-reference/search-brands",
              "api-reference/similar-brands",
              "api-reference/brand-prefix",
              "api-reference/get-brand",
              "api-reference/browse-brand-products",
              "api-reference/brand-top-categories"
            ]
          },
          {
            "group": "Coverage API",
            "pages": [
              "api-reference/create-url-list",
              "api-reference/list-url-lists",
              "api-reference/get-url-list",
              "api-reference/delete-url-list",
              "api-reference/add-url-list-urls",
              "api-reference/remove-url-list-urls",
              "api-reference/check-url-list-urls",
              "api-reference/list-url-list-urls"
