{
  "$schema": "https://mintlify.com/docs.json",
  "name": "StoreRouter",
  "theme": "luma",
  "logo": {
    "light": "/images/storerouter-logo-light.svg",
    "dark": "/images/storerouter-logo-dark.svg",
    "href": "https://storerouter.ai"
  },
  "favicon": "/images/storerouter-icon.svg",
  "colors": {
    "primary": "#D01F5C",
    "light": "#EC6483",
    "dark": "#D01F5C"
  },
  "navbar": {
