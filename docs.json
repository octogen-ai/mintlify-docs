              "organization-setup",
              "introduction",
              "authentication",
              "quickstart"
            ]
          },
          {
            "group": "SDKs",
            "pages": [
              "sdks/python",
              "sdks/typescript"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "cli/overview"
            ]
          },
          {
            "group": "MCP Integration",
            "pages": [
              "mcp/overview",
              "mcp/claude-code",
              "mcp/claude-desktop",
              "mcp/codex-cli"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/catalog-search",
              "guides/brand-discovery",
              "guides/product-lookup",
              "guides/more-like-this",
              "guides/mlt-strategy-recipes",
              "guides/bigquery-subscribe",
              "guides/coverage-url-lists",
              "guides/pagination",
              "guides/error-handling",
              "guides/pricing-and-billing",
              "guides/rate-limits",
              "guides/faq"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          "api-reference/overview",
          {
            "group": "Catalog API",
            "pages": [
              "api-reference/search-products",
              "api-reference/lookup-product",
              "api-reference/more-like-this"
            ]
